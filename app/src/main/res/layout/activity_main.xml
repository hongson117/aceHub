<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/app_icon"
                android:contentDescription="App Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACESTREAM HUB"
                    android:textColor="#38BDF8"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Universal Stream Proxy • Headless 24/7 Server • Cổng 8000"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHubStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#166534"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="🟢 ĐANG HOẠT ĐỘNG" />
        </LinearLayout>

        <!-- Main Cards Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left Column: Status & Connection -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <!-- Card: Trạng thái & Địa chỉ IP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐỊA CHỈ TRẠM PHÁT MẠNG NỘI BỘ (LAN)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServerUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="http://192.168.1.xxx:8000"
                        android:textColor="#00E676"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#334155"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Engine AceStream:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvEngineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sẵn sàng (Port 6878/62062)"
                            android:textColor="#F1F5F9"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Giới hạn RAM Cache:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 MB (Cực nhẹ cho Box 2GB)"
                            android:textColor="#38BDF8"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tự chạy khi khởi động:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BẬT (Boot Receiver)"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card: Cú pháp URL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HƯỚNG DẪN KẾT NỐI CHO THIẾT BỊ KHÁC"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Trên G2, Samsung Smart TV (Tizen), Apple TV (VPhim) hoặc PC, mở link:"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSampleUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:text="http://192.168.1.xxx:8000/?infohash=&lt;MÃ_KÊNH&gt;"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="💡 FPT Box chỉ làm nhiệm vụ nhận và chia sẻ luồng (Proxy), hoàn toàn không giải mã video nên không bị nóng và không bao giờ lag."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column: Realtime Stats & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:orientation="vertical">

                <!-- Card: Thống kê thời gian thực -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOẠT ĐỘNG THỜI GIAN THỰC (REALTIME)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kênh đang phát:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvActiveChannel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chờ kết nối..."
                            android:textColor="#F1F5F9"
                            android:fontFamily="monospace"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thiết bị đang xem:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvClientCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 thiết bị (Clients)"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tốc độ truyền tải:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 KB/s"
                            android:textColor="#38BDF8"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mạng P2P Swarm:"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvPeers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Peers"
                            android:textColor="#F1F5F9"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card: Nút điều khiển Remote -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐIỀU KHIỂN BẰNG REMOTE TV"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnTestStream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Thử luồng Eleven Sports 1"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnRestartHub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Khởi động lại Hub &amp; Engine"
                        android:backgroundTint="#334155"
                        android:textColor="#E2E8F0"
                        android:focusable="true"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnHideBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔽 Chạy ẩn (Về màn hình Home)"
                        android:backgroundTint="#166534"
                        android:textColor="#4ADE80"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
