<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Header: Logo, Name, Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/app_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="AceHub"
                android:textColor="#38BDF8"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="P2P Streaming Server • Cổng 8000"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="ĐANG KHỞI ĐỘNG..."
            android:textColor="#F59E0B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main Server Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="THÔNG SỐ MÁY CHỦ"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Địa chỉ máy chủ:"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvServerAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="http://127.0.0.1:8000"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Luồng đang chạy:"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCurrentChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Không có (Standby)"
                android:textColor="#4ADE80"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Kết nối P2P Swarm:"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvP2pStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Peers • 0 KB/s"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Thiết bị đang xem:"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvClientCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Client(s)"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Tự giữ Tailscale:"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTailscaleKeepStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐÃ TẮT (Không can thiệp)"
                android:textColor="#94A3B8"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV Remote Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStopStream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#DC2626"
            android:focusable="true"
            android:nextFocusRight="@+id/btnRestartServer"
            android:text="Dừng Luồng Phát"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRestartServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#0284C7"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnStopStream"
            android:nextFocusRight="@+id/btnToggleTailscale"
            android:text="Khởi Động Lại Server"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnToggleTailscale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#334155"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnRestartServer"
            android:nextFocusRight="@+id/btnExitApp"
            android:text="Tự Giữ Tailscale: TẮT"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExitApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#334155"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnToggleTailscale"
            android:text="Chạy Ngầm (Thoát Ra Màn Hình Chính)"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- LAN Connection Guide -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#0F172A"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="ĐƯỜNG DẪN KẾT NỐI CHO SAMSUNG TV / APPLE TV / PC"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGuideLinkGetstream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="http://127.0.0.1:8000/ace/getstream?infohash={mã_kênh}"
            android:textColor="#A5F3FC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGuideLinkMp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="http://127.0.0.1:8000/infohash/{mã_kênh}/stream.mp4"
            android:textColor="#A5F3FC"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
